<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<carousel name="systemcarousel">
			<type>vertical_wheel</type>
			<size>1 1</size>
			<color>00000000</color>
			<!-- <colorEnd>00000000</colorEnd> -->
			<!-- <logoScale>1.4</logoScale> -->
			<logoRotation>-7</logoRotation>
			<logoSize>0.155 0.155</logoSize>
			<logoSize ifSubset="systemlogocops1:logosimple">0.15 0.08</logoSize>
			<pos>0.34 0</pos>
			<maxLogoCount>16</maxLogoCount>
			<logoRotationOrigin>2.7 0.5</logoRotationOrigin>
			<logoAlignment>center</logoAlignment>
			<!-- <imageSource>marquee</imageSource> -->
			<systemInfoDelay>700</systemInfoDelay>
			<systemInfoCountOnly>false</systemInfoCountOnly>
			<defaultTransition>instant</defaultTransition>
			<transitionSpeed>650</transitionSpeed>
			<minLogoOpacity>1</minLogoOpacity>
			<zIndex>105</zIndex>
		</carousel>
		<image name="logo">
			<storyboard event="activate" repeatAt="1">
				<animation property="scale" from="1.1" to="1.3" begin="0" duration="1000" mode="easeOut"/>
				<animation property="scale" from="1.3" to="1.1" begin="1000" duration="1000" mode="easeOut"/>
			</storyboard>
		</image>
		<image name="staticBackground198">
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<path>${themePath}/_viewsyst/hypermx/art/backmarquee.png</path>
			<zIndex>20</zIndex>
		</image>
		<image name="pointer" extra="true">
			<linearSmooth>true</linearSmooth>
			<pos>0.973 0.50</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.075 0.175</maxSize>
			<default >${themePath}/_systemmedia/pointers-r/default.png</default>
			<path>${pointers4syst}</path>
			<zIndex>150</zIndex>
			<storyboard repeat="forever">
				<animation property="x" from="0.963" to="0.940" duration="60" autoreverse="true" begin="4000" repeat="3"/>
			</storyboard>
		</image>
		<text name="systemInfo">
			<fontPath>${themePath}/_viewsyst/hypermx/gomarice_no_continue.ttf</fontPath>
			<fontSize>0.040</fontSize>
			<pos>-0.15 0.84</pos>
			<color>ffffff</color>
			<glowColor>000000</glowColor>
			<rotation>-4</rotation>
			<zIndex>900</zIndex>
			<storyboard>
				<animation property="y" from="0.7" begin="1300" duration="350" mode="easeOutQuint"/>
				<animation property="scale" to="1.05" begin="0" duration="200" autoreverse="true" repeat="forever" mode="easeOut"/>
				<animation property="opacity" from="0" to="0" duration="1300" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="1300" duration="350" mode="linear"/>
			</storyboard>
		</text>
		<image name="cadrevideo" extra="true">
			<origin>0 0</origin>
			<pos>0 0</pos>
			<size>1 1</size>
			<path>${themePath}/_viewsyst/hypermx/art/cadrevideo.png</path>
			<color>ffffff</color>
			<storyboard>
				<animation property="opacity" from="0" to="1" duration="650" mode="easeIn"/>
			</storyboard>
			<zIndex>2</zIndex>
		</image>
		<image name="fanartflix" extra="true">
			<storyboard>
				<animation property="y" from="-2" begin="0" duration="0" mode="easyOut"/>
				<animation property="scale" to="1.2" begin="350" autoreverse="true" duration="3200" repeat="forever" mode="easyIn"/>
				<animation property="opacity" to="1" duration="350" mode="linear"/>
			</storyboard>
		</image>
		<image name="titreystem" extra="true">
			<pos>0.25 0</pos>
			<maxSize>0.28 0.28</maxSize>
			<color>ffffff</color>
			<rotation>-4</rotation>
			<!-- <path>${intlogoclearpng}</path> -->
			<path>${bobmediapath}/_systemmedia/_logosyst/clearlogos/${system.theme}.png</path>
			<path>${bobmediapath}/_systemmedia/_logosyst/clearlogos/region-${region}/${system.theme}-${region}.png</path>
			<path>${bobmediapath}/_systemmedia/_logosyst/clearlogos/lang-${lang}/${system.theme}-${lang}.png</path>
			<zIndex>998</zIndex>
			<storyboard>
				<animation property="x" from="0" begin="0" duration="500" mode="easyOut"/>
				<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
				<animation property="y" from="-0.01" begin="0" duration="500" autoreverse="true" repeat="forever" mode="easyInOut"/>
			</storyboard>
		</image>
		<image name="persopng" extra="true">
			<linearSmooth>true</linearSmooth>
			<origin>0 0</origin>
			<pos>0 0.08</pos>
			<maxSize>0.3 0.8</maxSize>
			<color>ffffff</color>
			<path>${themePath}/_systemmedia/charsystem/${system.theme}.png</path>
			<zIndex>998</zIndex>
			<storyboard>
				<animation property="x" from="-0.1" begin="0" duration="600" mode="bump"/>
				<animation property="scale" to="1.08" begin="600" autoreverse="true" duration="900" repeat="forever" mode="easyIn"/>
				<animation property="rotation" to="-5.5" begin="600" autoreverse="true" duration="900" repeat="forever" mode="easyIn"/>
			</storyboard>
		</image>
		<image name="maxhardw" extra="true">
			<linearSmooth>true</linearSmooth>
			<origin>1 0</origin>
			<pos>0.75 0.75</pos>
			<maxSize>0.2 0.2</maxSize>
			<path>${themePath}/_systemmedia/hardware/${system.theme}.png</path>
			<zIndex>999</zIndex>
			<storyboard>
				<animation property="y" from="1.01" begin="0" duration="1000" mode="Bump"/>
				<animation property="scale" to="1.02" begin="1100" autoreverse="true" duration="300" repeat="forever" mode="easyIn"/>
			</storyboard>
		</image>
		<video name="maxgameplay" extra="true">
			<visible>true</visible>
			<default>${themePath}/_viewsyst/hypermx/defaut/scotty.mp4</default>
			<path>{random}</path>
			<rotation>-4</rotation>
			<roundCorners>0.04</roundCorners>
			<pos>0.45 0.485</pos>
			<origin>0.5 0.5</origin>
			<size>0.4860 0.682</size>
			<delay>0.3</delay>
			<showSnapshotNoVideo>false</showSnapshotNoVideo>
			<showSnapshotDelay>false</showSnapshotDelay>
			<color>FFFFFF</color>
			<storyboard>
				<animation property="y" from="0.05" begin="0" duration="350" mode="easeOut"/>
				<animation property="opacity" from="0" to="1" duration="550" mode="easeIn"/>
				<animation property="scale" from="0" to="1" duration="350" mode="easeOut"/>
			</storyboard>
			<zIndex>200</zIndex>
		</video>
	</view>
</theme>
